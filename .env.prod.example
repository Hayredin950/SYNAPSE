# ============================================================
# SYNAPSE — PRODUCTION Environment (Oracle Cloud ARM + Vercel)
# ============================================================
# Copy to /opt/synapse/.env.prod on the Oracle box, fill in real
# values, chmod 600. NEVER commit .env.prod.
#
# Architecture:
#   • Oracle Cloud ARM Ampere A1 (4 vCPU / 24 GB) — API + AI + workers
#   • Postgres (pgvector) + Redis — Docker on the same box
#   • Frontend — Vercel Hobby (uses its own *.vercel.app URL)
#   • Email — Brevo SMTP
#   • DNS — DuckDNS (A record → box IP), TLS — Let's Encrypt via certbot
# ============================================================

# ── Django Core ─────────────────────────────────────────────
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_generate_with_python
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
# The DuckDNS hostname that points at the Oracle box (API + admin + AI)
ALLOWED_HOSTS=synapseai.duckdns.org,localhost,127.0.0.1
# Must match ALLOWED_HOSTS (with https://) so Django trusts CSRF from nginx
# ── Frontend (Vercel) ───────────────────────────────────────
# Set these in the Vercel project (NOT on the box):
#   NEXT_PUBLIC_API_URL=https://synapseai.duckdns.org
#   NEXT_PUBLIC_WS_URL=wss://synapseai.duckdns.org/ws
#   NEXT_PUBLIC_APP_URL=https://<your-project>.vercel.app
#   NEXT_PUBLIC_APP_NAME=SYNAPSE
# On the box, FRONTEND_URL is only used for CORS defaults:
FRONTEND_URL=https://<your-project>.vercel.app
# Comma-separated origins allowed to call the API (your Vercel URL)
CORS_ALLOWED_ORIGINS=https://<your-project>.vercel.app
# Comma-separated; must include the Vercel URL for POST /auth flows
CSRF_TRUSTED_ORIGINS=https://synapseai.duckdns.org,https://<your-project>.vercel.app

# ── Database (Postgres in Docker) ───────────────────────────
# docker-compose.prod.yml sets DB_HOST=postgres / DB_PORT=5432 itself.
# Only the values below come from this file.
DB_NAME=synapse_db
DB_USER=synapse_user
DB_PASSWORD=CHANGE_ME_strong_password_32_chars_min
# Optional: pass DATABASE_URL instead to override host/port/ssl

# ── Redis (in Docker) ───────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_another_strong_password
# Celery broker/result use the REDIS_URL built from REDIS_PASSWORD.
# If you override REDIS_URL, also set CELERY_BROKER_URL and
# CELERY_RESULT_BACKEND.

# ── Email — Brevo (free 300/day) ────────────────────────────
# Dashboard: https://app.brevo.com/settings/keys/smtp
#   SMTP server:   smtp-relay.brevo.com
#   Port:          587 (STARTTLS) or 465 (SSL)
#   Login:         your Brevo account email (SMTP login)
#   Password:      your SMTP master key
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=YOUR_BREVO_SMTP_LOGIN_OR_EMAIL
EMAIL_HOST_PASSWORD=YOUR_BREVO_SMTP_KEY
DEFAULT_FROM_EMAIL=SYNAPSE <noreply@synapse.ai>
SUPPORT_EMAIL=support@synapse.ai

# ── AI Providers (fallback chain: Groq → NVIDIA → Gemini) ───
# Free keys:
#   Groq   → https://console.groq.com/keys            (14,400 req/day)
#   NVIDIA → https://build.nvidia.com                 (free endpoints)
#   Gemini → https://aistudio.google.com/apikey       (free tier)
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
# Optional: OPENROUTER_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY

# ── Embeddings (local — free, unmetered) ────────────────────
# MUST match the vector column width (1024). The embedder refuses to
# start on a mismatch rather than failing inside Postgres.
# ── Embeddings ────────────────────────────────────────────────
# MUST match the vector column width (1024). The embedder refuses to
# start on a mismatch rather than failing inside Postgres.
#   local → sentence-transformers on the box (default in full mode)
#   api   → NVIDIA NIM hosted endpoint, nvidia/nv-embedqa-e5-v5 (1024 dims)
#           (default when SYNAPSE_LITE=1 — no torch in RAM)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
# EMBEDDING_API_MODEL=nvidia/nv-embedqa-e5-v5
# EMBEDDING_API_BASE_URL=https://integrate.api.nvidia.com/v1
# EMBEDDING_API_KEY=<falls back to NVIDIA_API_KEY>

# ── SYNAPSE Lite mode (small-box deployment) ──────────────────
# SYNAPSE_LITE=1 → no local ML models loaded; summarization/topic/
# sentiment via the cloud LLMs (Groq → NVIDIA → Gemini) and embeddings
# via the API. Build the slim images with the same flag. Set to 0
# (default) for the full local-model stack. On a small box also lower
# the compose memory limits: BACKEND_MEM_LIMIT=768M AI_MEM_LIMIT=1G
SYNAPSE_LITE=0


# ── OAuth (optional, leave blank to disable the buttons) ────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://synapseai.duckdns.org/api/v1/auth/github/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Security / Rate limits (production must NOT disable) ────
# DISABLE_RATE_LIMITS must stay unset/false in production.
RATE_LIMIT_FREE=100/minute
RATE_LIMIT_PRO=1000/minute
RATE_LIMIT_AI=10/minute
LOGIN_MAX_ATTEMPTS=5
LOGIN_COOLDOWN_MINUTES=15
JWT_SIGNING_KEY=CHANGE_ME_generate_with_python
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Monitoring ──────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=True

# ── Celery ──────────────────────────────────────────────────
CELERY_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=1000
CELERY_QUEUES=default,scraping,slow_scraping,agents,nlp,embeddings
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_flower_password

# ── Scrapers / data sources (optional) ──────────────────────
GITHUB_TOKEN=
YOUTUBE_API_KEY=
NEWS_API_KEY=
X_API_KEY=

# ── Feature flags ───────────────────────────────────────────
ENABLE_SCRAPING=True
ENABLE_NLP=True
ENABLE_AI_CHAT=True
ENABLE_AGENTS=True
ENABLE_NOTIFICATIONS=True

# ── Docker-only (compose fills these in) ────────────────────
IMAGE_OWNER=hayredin950
IMAGE_TAG=latest

# DuckDNS (updates the A record to the box IP every 5 min)
DUCKDNS_DOMAIN=synapseai
DUCKDNS_TOKEN=CHANGE_ME_duckdns_token
DATABASE_URL=
REDIS_URL=
