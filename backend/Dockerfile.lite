# ── Stage 1: Dependencies (cached unless requirements change) ────────────────
# Lite image for Render free tier (512 MB). Build context is the REPO ROOT
# (Render sends the entire repo as context), so paths like backend/requirements.txt
# and ai_engine/ are available.
#
# WHY THIS FILE EXISTS:
#   Render's blueprint (render.yaml) schema does NOT support passing Docker
#   build args — the only docker keys are dockerCommand / dockerfilePath /
#   dockerContext. The main Dockerfile defaults to FULL mode (torch +
#   transformers + spaCy ≈ 2-3 GB), which overflows the free 512 MB instance.
#   This file defaults to lite mode instead, so the image is a normal Django
#   app (~500 MB) with ML work delegated to cloud APIs.
#
#   The Oracle box keeps using backend/Dockerfile (full mode) via
#   docker-compose.prod.yml, which passes SYNAPSE_LITE=${SYNAPSE_LITE:-0}
#   explicitly — so the two paths stay independent.
FROM python:3.11-slim AS builder
WORKDIR /app

ARG SYNAPSE_LITE=1

RUN apt-get update && apt-get install -y \
    build-essential libpq-dev gcc curl \
    && rm -rf /var/lib/apt/lists/*

# Copy ONLY backend requirements first — Docker caches this layer
COPY backend/requirements.txt backend/requirements.lite.txt ./
RUN pip install --upgrade pip \
    && if [ "$SYNAPSE_LITE" = "1" ]; then \
         pip install --no-cache-dir -r requirements.lite.txt --use-deprecated=legacy-resolver; \
       else \
         pip install --no-cache-dir -r requirements.txt --use-deprecated=legacy-resolver; \
       fi

# ── Stage 2: Production ───────────────────────────────────────────────────────
FROM python:3.11-slim AS production
WORKDIR /app

RUN apt-get update && apt-get install -y libpq-dev curl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# yt-dlp is required by the YouTube scraper (scrape_videos workflow)
# beautifulsoup4 is required by the direct HTTP tweet scraper
RUN pip install yt-dlp beautifulsoup4 --no-cache-dir

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app

# Copy backend source code (manage.py, config/, apps/ etc. go to /app/)
COPY --chown=appuser:appuser backend/ .

# Copy ai_engine module (required for AI agents, embeddings, NLP)
COPY --chown=appuser:appuser ai_engine/ ./ai_engine/

# Make the start scripts executable.
RUN chmod +x /app/start-web.sh /app/start-worker.sh /app/start-beat.sh /app/start-worker-with-health.sh

USER appuser
EXPOSE 8000

# Ensure production settings are used (asgi.py defaults to development)
ENV DJANGO_SETTINGS_MODULE=config.settings.production

# Default CMD = web service (Daphne). The Celery worker and Beat services
# on Render would override this via their "Docker Command" field.
CMD ["/app/start-web.sh"]
