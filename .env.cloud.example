# ============================================================
# SYNAPSE — CARD-FREE LITE-MODE CLOUD ENV TEMPLATE
# ============================================================
# Target stack (no credit card, no laptop serving):
#
#   Frontend  → Vercel (already live: https://synapse-one-blond.vercel.app)
#   Backend   → Render FREE web service  (Django/Daphne, SYNAPSE_LITE=1)
#   Database  → Neon Postgres + pgvector (free, no card)
#   Redis     → Upstash Redis            (free, no card)
#   Celery    → GitHub Actions cron      (public repo = unlimited minutes)
#
# Fill every CHANGE_ME below, then paste the values into:
#   1. Render:  dashboard → synapse-backend → Environment
#   2. GitHub:  Settings → Secrets and variables → Actions → Secrets
#   3. Vercel:  frontend project → Settings → Environment Variables
# ============================================================

# ── Neon Postgres (https://neon.tech → New Project → connect) ────────────────
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/synapse_db?sslmode=require
# Use the "Pooled connection" string from Neon (it proxies through pgbouncer).
DATABASE_URL=postgresql://CHANGE_ME

# ── Upstash Redis (https://upstash.com → Create Database → REST & Redis) ─────
# Format: rediss://default:password@xxxx.upstash.io:6379
# Must be the "rediss://" TLS URL. The code normalizes it to DB 0 automatically
# (Upstash free tier only allows DB 0).
REDIS_URL=rediss://CHANGE_ME

# ── Django secrets (generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())") ──
SECRET_KEY=CHANGE_ME
JWT_SIGNING_KEY=CHANGE_ME
DB_PASSWORD=CHANGE_ME          # legacy — used by docker-compose paths only
REDIS_PASSWORD=CHANGE_ME       # legacy — used by docker-compose paths only

# ── AI providers (all free tiers) ────────────────────────────────────────────
GROQ_API_KEY=gsk_...           # https://console.groq.com/keys
NVIDIA_API_KEY=nvapi-...       # https://build.nvidia.com → Get API Key
GEMINI_API_KEY=AIza...         # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=            # optional
TAVILY_API_KEY=                # optional — web search tool for agents

# ── Email (Brevo SMTP — https://app.brevo.com → SMTP & API → SMTP) ───────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_ME      # Brevo "Login" e.g. xxxxx@smtp-brevo.com
EMAIL_HOST_PASSWORD=CHANGE_ME  # Brevo SMTP key (xsmtpsib-...)
DEFAULT_FROM_EMAIL="SYNAPSE <noreply@synapse.ai>"

# ── Hostnames / CORS ─────────────────────────────────────────────────────────
# Render: dashboard → synapse-backend → the URL it gives you (e.g. synapse-backend.onrender.com)
# Vercel: your live frontend URL
ALLOWED_HOSTS=synapse-backend.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://synapse-backend.onrender.com,https://synapse-one-blond.vercel.app
CORS_ALLOWED_ORIGINS=https://synapse-one-blond.vercel.app
FRONTEND_URL=https://synapse-one-blond.vercel.app

# ── Lite mode (MUST stay on for the free-tier stopgap) ───────────────────────
SYNAPSE_LITE=1
EMBEDDING_PROVIDER=api         # NVIDIA NIM embeddings (no local model)
EMBEDDING_DIM=1024
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5   # kept for compat; API provider used
AI_ENGINE_URL=http://localhost:8001      # unused in lite mode (direct imports)

# ── Feature toggles ──────────────────────────────────────────────────────────
ENABLE_AGENTS=True
ENABLE_AI_CHAT=True
ENABLE_NLP=True
ENABLE_SCRAPING=True
ENABLE_NOTIFICATIONS=True
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production

# ── Worker tuning (GH Actions cron worker) ───────────────────────────────────
CELERY_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=50
CELERY_QUEUES=default,scraping,slow_scraping,agents,nlp,embeddings

# ── Render health endpoint (for the GH Actions keep-warm ping) ───────────────
RENDER_HEALTH_URL=https://synapse-backend.onrender.com/api/v1/health/

# ── Vercel only (frontend) ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://synapse-backend.onrender.com
NEXT_PUBLIC_WS_URL=wss://synapse-backend.onrender.com/ws
NEXT_PUBLIC_APP_URL=https://synapse-one-blond.vercel.app
NEXT_PUBLIC_APP_NAME=SYNAPSE

# ── Optional ─────────────────────────────────────────────────────────────────
# SENTRY_DSN=            # error tracking
# GOOGLE_CLIENT_ID=      # Google OAuth (optional)
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=      # GitHub OAuth (optional)
# GITHUB_CLIENT_SECRET=
